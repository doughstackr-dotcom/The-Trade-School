# Local reference only — copy to .env if you use CLI tools.
# Never commit real values. The static site does not read this file.
# See docs/SECRETS.md and docs/ACCOUNTS.md.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_OR_eyJ_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ_SERVICE_ROLE_SERVER_ONLY

# Stripe (Edge Function secrets — also listed here for local ops checklists)
STRIPE_SECRET_KEY=sk_test_or_live
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BEGINNER=price_xxx
STRIPE_PRICE_ADVANCED=price_xxx

# Site
SITE_URL=http://localhost:5173/
ALLOWED_ORIGINS=http://localhost:5173

# Market data (Edge Function)
ALPHA_VANTAGE_API_KEY=YOUR_KEY

# Optional SMTP notes (configure in Supabase Auth UI, not in the browser)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SMTP_PASSWORD
